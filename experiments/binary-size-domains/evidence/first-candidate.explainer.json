          "id": "domain-steps",
          "type": "steps",
          "items": [
            {
              "id": "step-file",
              "text": "先看文件长度",
              "detail": "16,888 B 是整个文件的逻辑长度，不是 payload 的大小，也不是磁盘已分配块数。",
              "target": {
                "diagram": "domain-map",
                "node": "file"
              }
            },
            {
              "id": "step-total",
              "text": "再读报告 total",
              "detail": "size -m 累加段的 vmsize；此例连 4 GiB 的 PAGEZERO 都计入。",
              "target": {
                "diagram": "domain-map",
                "node": "total"
              }
            },
            {
              "id": "step-guard",
              "text": "分出不可访问区域",
              "detail": "PAGEZERO 的 maxprot 与 initprot 均为 0，filesize 也为 0；Bloaty 源码不将此类区域计入 VM。",
              "target": {
                "diagram": "domain-map",
                "node": "guard"
              }
            },
            {
              "id": "step-permitted",
              "text": "其余尺寸仍是静态信息",
              "detail": "三个 maxprot 非零的段合计 1,081,344 B。这不是运行时 RSS。",
              "target": {
