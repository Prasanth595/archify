  "cards": [
    {
      "dot": "amber",
      "title": "Retry budget",
      "items": [
        "maxRetries = 15 per key, then the key is dropped (deployment_controller.go:59)",
        "Per-item delay doubles from a 5ms base, capped at 1000s (default_rate_limiters.go:52)",
        "A successful sync calls Forget, so the backoff counter resets"
      ]
    },
    {
      "dot": "cyan",
      "title": "Reads come from the cache",
      "items": [
        "syncDeployment reads Deployments through the informer lister, not the API server",
        "Only adoption checks and writes go straight to the API server"
      ]
    }
