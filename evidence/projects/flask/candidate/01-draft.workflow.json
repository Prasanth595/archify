  "cards": [
    {
      "dot": "cyan",
      "title": "Hook order (src/flask/app.py)",
      "items": [
        "before_request: app-level first, then blueprints outermost to innermost (app.py:1377)",
        "after_request: blueprints innermost to outermost, then app-level (app.py:1410)",
        "process_response also saves the session (app.py:1415)"
      ]
    },
    {
      "dot": "rose",
      "title": "Ordering details",
      "items": [
        "response(environ, start_response) runs before ctx.pop(error) (app.py:1604, app.py:1616)",
        "handle_exception ends in finalize_request(from_error_handler=True) (app.py:948)",
        "handle_user_exception re-raises when no handler is registered (app.py:892)"
      ]
    }
