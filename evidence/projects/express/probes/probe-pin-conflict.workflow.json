  "cards": [
    {
      "dot": "cyan",
      "title": "Where matching happens",
      "items": [
        "Express 5 has no lib/router: path matching is the npm router package",
        "app.init() creates the Router lazily on first access",
        "app.route() and app.get() register isolated Route stacks"
      ]
    },
    {
      "dot": "rose",
      "title": "Error propagation",
      "items": [
        "next(err) skips the remaining handlers and reaches done",
        "done is the finalhandler built in app.handle()",
        "logerror prints the error unless NODE_ENV is test"
      ]
    }
  ]
