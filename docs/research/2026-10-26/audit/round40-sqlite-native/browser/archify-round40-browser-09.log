root
  container
    paragraph
      text "against it and annotates every line of their output with a plain-English description. Powered by Python's"
      text "sqlite3"
      text "module running in your browser via"
      anchor [ref=544, loc=href:https://pyodide.org/, url=https://pyodide.org/]
        text "Pyodide"
      text "— nothing you load or type leaves your machine."
    container
      heading
        text "1. Choose a database"
      container
        button [ref=545]
          text "Load example database"
        text "or"
        button [ref=546]
          text "Open your own SQLite database…"
      paragraph
        text "The data is generated with a fixed random seed, so results are reproducible — and queries you run are stored in the page URL, so you can bookmark or share them."
      container [ref=554]
        text "Database schema"
    container
      heading
        text "2. Run a query"
      container
        text "Example queries:"
        combobox [ref=555]
          text "Choose an example…"
      textbox [ref=556, loc=css:textarea[placeholder="SELECT ..."]]
        text "SELECT name, (SELECT COUNT(*) FROM orders WHERE customer_id = customers.id) AS order_count FROM customers;"
      container
        button [ref=557]
          text "Run & explain"
        text "Ctrl/Cmd + Enter"
    container
      heading
        text "Results"
      paragraph
        text "200+ row(s) in 0.5 ms — showing the first 200"
