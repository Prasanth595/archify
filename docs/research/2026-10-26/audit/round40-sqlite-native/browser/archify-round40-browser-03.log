[p1 "SQLite Query Explainer" | space "Archify research 20261026"(3): 1 managed, 0 untracked — p1* "SQLite Query Explainer"]
root
  container
    heading
      text "SQLite Query Explainer"
    paragraph
      text "Run SQL against a SQLite database and see what the query planner is really doing: the tool executes your query, then runs"
      text "EXPLAIN QUERY PLAN"
      text "and"
      text "EXPLAIN"
      text "against it and annotates every line of their output with a plain-English description. Powered by Python's"
      text "sqlite3"
      text "module running in your browser via"
      anchor [ref=544, loc=href:https://pyodide.org/, url=https://pyodide.org/]
        text "Pyodide"
      text "— nothing you load or type leaves your machine."
    container
      heading
        text "1. Choose a database"
      container
        button [ref=545]
          text "Load example database"
        text "or"
        button [ref=546]
          text "Open your own SQLite database…"
      paragraph
        text "The data is generated with a fixed random seed, so results are reproducible — and queries you run are stored in the page URL, so you can bookmark or share them."
      container
        container [ref=554]
          text "Database schema"
        container
          container
            text "TABLE"
            text "customers"
            text "— 2,000 rows"
          text "CREATE TABLE customers ( id INTEGER PRIMARY KEY, name TEXT NOT NULL, email TEXT UNIQUE, country TEXT, signup_date TEXT )"
          container
            text "TABLE"
            text "events"
            text "— 50,000 rows"
          text "CREATE TABLE events ( id INTEGER PRIMARY KEY, customer_id INTEGER, event_type TEXT, created_at TEXT )"
          container
            text "TABLE"
            text "order_items"
            text "— 39,907 rows"
          text "CREATE TABLE order_items ( order_id INTEGER REFERENCES orders(id), product_id INTEGER REFERENCES products(id), quantity INTEGER, unit_price REAL, PRIMARY KEY (order_id, product_id) ) WITHOUT ROWID"
          container
            text "TABLE"
            text "orders"
            text "— 20,000 rows"
          text "CREATE TABLE orders ( id INTEGER PRIMARY KEY, customer_id INTEGER REFERENCES customers(id), order_date TEXT, status TEXT )"
          container
            text "TABLE"
            text "products"
            text "— 200 rows"
          text "CREATE TABLE products ( id INTEGER PRIMARY KEY, name TEXT NOT NULL, category TEXT, price REAL )"
          container
            text "INDEX"
            text "idx_customers_country"
            text "on customers"
          text "CREATE INDEX idx_customers_country ON customers(country)"
          container
            text "INDEX"
            text "idx_orders_customer"
            text "on orders"
          text "CREATE INDEX idx_orders_customer ON orders(customer_id)"
          container
            text "INDEX"
            text "idx_orders_date"
            text "on orders"
          text "CREATE INDEX idx_orders_date ON orders(order_date)"
          container
            text "INDEX"
            text "idx_products_category_price"
            text "on products"
          text "CREATE INDEX idx_products_category_price ON products(category, price)"
          container
            text "VIEW"
            text "order_totals"
          text "CREATE VIEW order_totals AS SELECT o.id AS order_id, o.customer_id, SUM(oi.quantity * oi.unit_price) AS total FROM orders o JOIN order_items oi ON oi.order_id = o.id GROUP BY o.id"
    container
      heading
        text "2. Run a query"
      container
        text "Example queries:"
        combobox [ref=555]
          text "1. Full table scan"
        paragraph
          text "The events table has no index on event_type, so SQLite has to visit all 50,000 rows and test each one."
      textbox [ref=556, loc=css:textarea[placeholder="SELECT ..."]]
        text "SELECT * FROM events WHERE event_type = 'purchase' LIMIT 10"
      container
        button [ref=557]
          text "Run & explain"
        text "Ctrl/Cmd + Enter"
    container
