{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Northstar image processing: upload, queue, transformation and notification",
    "locale": "en",
    "output": "northstar.html",
    "quality_profile": "showcase",
    "viewBox": [1100, 420]
  },
  "components": [
    { "id": "browser", "type": "frontend", "label": "Browser", "pos": [40, 40], "size": [160, 60] },
    { "id": "upload-api", "type": "backend", "label": "Upload API", "pos": [350, 40], "size": [140, 60] },
    { "id": "job-queue", "type": "messagebus", "label": "Job Queue", "pos": [740, 40], "size": [150, 60] },
    { "id": "object-store", "type": "database", "label": "Object Store", "pos": [350, 220], "size": [140, 60] },
    { "id": "transform-worker", "type": "backend", "label": "Transform Worker", "pos": [740, 220], "size": [150, 60] },
    { "id": "result-store", "type": "database", "label": "Result Store", "pos": [970, 220], "size": [110, 60] },
    { "id": "notification-service", "type": "backend", "label": "Notification Service", "pos": [40, 220], "size": [190, 60] }
  ],
  "connections": [
    { "id": "https-upload", "from": "browser", "to": "upload-api", "label": "HTTPS upload", "variant": "emphasis" },
    { "id": "write-original", "from": "upload-api", "to": "object-store", "label": "original" },
    { "id": "enqueue-job", "from": "upload-api", "to": "job-queue", "label": "enqueue" },
    { "id": "dispatch-job", "from": "job-queue", "to": "transform-worker", "label": "dispatch" },
    { "id": "read-original", "from": "transform-worker", "to": "object-store", "label": "read" },
    { "id": "write-result", "from": "transform-worker", "to": "result-store", "label": "result" },
    { "id": "publish-completion", "from": "transform-worker", "to": "notification-service", "label": "complete", "fromSide": "bottom", "toSide": "bottom" },
    { "id": "send-result-url", "from": "notification-service", "to": "browser", "label": "result URL" }
  ],
  "cards": [
    { "dot": "amber", "title": "Queue retries", "items": ["A failed job is retried at most three times.", "Exhausted jobs enter the dead-letter queue for operator review."] },
    { "dot": "emerald", "title": "Storage policy", "items": ["Originals expire after seven days; transformed results after thirty days.", "Completion notifications contain a result URL and no image bytes."] }
  ]
}
