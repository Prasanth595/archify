  "cards": [
    {
      "dot": "cyan",
      "title": "BPU V3 组成",
      "items": [
        "S1 由 uBTB、aBTB 与 uTAGE 提供早期目标和方向预测",
        "S3 由 mBTB、TAGE-SC、ITTAGE 与 RAS 完成精确覆盖或纠正",
        "公开 V3 设计页仍将 TAGE-SC、ITTAGE、RAS 的部分参数标为 TBD"
      ]
    },
    {
      "dot": "emerald",
      "title": "取指主路径",
      "items": [
        "FTQ 以预测块为单位向 IFU 和 ICache 供给最多两个 fetch block",
        "IFU F2 并行送入四个 PreDecode，F3 对最多 16 条指令做 32-bit 扩展",
        "PredChecker 在 F3 检查 JAL、ret、非法预测和目标地址错误，再把修正范围写回 FTQ"
      ]
    },
    {
      "dot": "violet",
      "title": "ICache 与异常路径",
      "items": [
        "V3 ICache 使用 64KB、4-way、64B cache line，支持 FDIP、2-fetch 和 4 个 fetch MSHR",
        "ITLB/PMP-PMA 提供翻译和取指权限检查；miss 通过 TileLink 请求 L2 并回填",
        "MMIO 取指进入 Instruction Uncache，并等待 commit 后继续推进"
      ]
    },
    {
      "dot": "rose",
      "title": "公开资料",
      "items": [
        "XiangShan-Design-Doc · kunminghu-v3 · frontend/BPU、IFU、ICache",
        "2025 RVSC：香山昆明湖 V3 前端架构总览",
        "资料状态：BPU 与 ICache 文档仍在 draft；本图保留 TBD 与文档边界"
      ]
    }
