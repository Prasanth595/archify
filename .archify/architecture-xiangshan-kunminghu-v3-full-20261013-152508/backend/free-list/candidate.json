  "cards": [
    {
      "dot": "cyan",
      "title": "设计职责",
      "items": [
        "freeList 环形存储待分配物理寄存器，tail 回收、head 分配。",
        "canAllocate 按 RenameWidth 做余量判断，walk 按自己的有效请求数分配。",
        "redirect 对普通分配有优先级，并以快照/架构 head 修复指针。"
      ]
    },
