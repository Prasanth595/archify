  "meta": {
    "title": "Why does a request slow down on a cache miss?",
    "id": "mechanism",
    "locale": "en"
  },
  "answer": {
    "summary": "After a cache miss, the request also waits for **the database query and the synchronous cache write-back**.",
    "reasons": [
      "On a hit, the endpoint returns as soon as it reads the cached value.",
      "On a miss, the endpoint must first get the database result.",
      "The synchronous write-back runs before the response, so the request ends only after the cache is written."
    ],
    "scope": "Cache-aside: after GET returns nil, query PostgreSQL, then SET synchronously before responding; no parallelism, retries, or other cache layers. Latency not measured."
  },
  "panels": [
    {
      "id": "timeline",
      "title": "Where does the time go on one miss?",
      "blocks": [
        {
          "type": "steps",
          "id": "cache-path-steps",
          "items": [
            {
              "id": "get-step",
              "text": "Read the cache",
              "detail": "GET returns nil, so the endpoint goes on to query the database.[](source:get-doc)"
            },
            {
              "id": "query-step",
              "text": "Query PostgreSQL",
              "detail": "Wait for the database to run the SQL and return the result."
            },
            {
              "id": "set-step",
              "text": "Write back to Redis",
              "detail": "Once SET completes, the endpoint returns the response.[](source:set-doc)"
            }
          ]
        }
      ]
    },
